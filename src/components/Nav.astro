---
import '../styles/global.css';  
---

<header class="bg-[#030e1e] text-white sticky top-0 z-50 shadow-md font-sans">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-24">
      
      <!-- Logo Section -->
      <div class="flex-shrink-0">
        <a href="/" class="flex items-center gap-3 group">
          <!-- Handshake SVG Icon -->
          <img 
            src="/Illinois-event-management-logo.svg" 
            alt="Illinois Event Management Company Logo" 
            class="h-14 w-auto brightness-0 invert opacity-80 group-hover:opacity-100 transition-opacity" 
            height="14"
            width="14"
          />

          <!-- Brand Text Stack -->
          <div class="flex flex-col text-left">
            <span class="font-serif text-2xl font-black tracking-widest text-white leading-none">
              ILLINOIS
            </span>
            <span class="text-[11px] font-bold tracking-wider text-[#c89234] uppercase mt-0.5 leading-none">
              EVENT MANAGEMENT COMPANY
            </span>
            
            <!-- Tagline with lines -->
            <div class="flex items-center gap-1.5 mt-1">
              <span class="h-[1px] w-4 bg-[#c89234]"></span>
              <span class="text-[9px] font-medium text-gray-200 tracking-tight leading-none">
                Your Event, Our Responsibility
              </span>
              <span class="h-[1px] w-4 bg-[#c89234]"></span>
            </div>
          </div>
        </a>
      </div>

      <!-- Desktop Navigation (Hidden on Mobile) -->
      <nav class="hidden lg:flex items-center space-x-8 text-sm font-semibold tracking-wider uppercase">
        <a href="/" class="hover:text-amber-500 transition-colors">HOME</a>

        <!-- Desktop About Us Dropdown -->
        <div class="relative group flex items-center">
          <button 
            type="button" 
            class="flex items-center gap-1 text-slate-100 hover:text-amber-500 focus:outline-none transition-colors py-2"
          >
            <span>ABOUT US</span>
            <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
              <path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" />
            </svg>
          </button>
          
          <div class="absolute left-0 top-full pt-2 w-48 hidden group-hover:block transition-all">
            <div class="rounded-md shadow-lg bg-[#07162c] border border-gray-800 py-2">
              <a href="/about/" class="block px-4 py-2 text-xs normal-case text-gray-200 hover:bg-amber-600 hover:text-white">About Us</a>
              <a href="/upcoming-events/" class="block px-4 py-2 text-xs normal-case text-gray-200 hover:bg-amber-600 hover:text-white">Upcoming Events</a>
              <a href="/past-events/" class="block px-4 py-2 text-xs normal-case text-gray-200 hover:bg-amber-600 hover:text-white">Past Events</a>
            </div>
          </div>
        </div>
        
        <!-- Desktop Services Dropdown -->
        <div class="relative group flex items-center">
          <button 
            type="button" 
            class="flex items-center gap-1 text-slate-100 hover:text-amber-500 focus:outline-none transition-colors py-2"
          >
            <span>SERVICES</span>
            <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
              <path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" />
            </svg>
          </button>
          
          <div class="absolute left-0 top-full pt-2 w-48 hidden group-hover:block transition-all">
            <div class="rounded-md shadow-lg bg-[#07162c] border border-gray-800 py-2">
              <a href="/services/event-planning/" class="block px-4 py-2 text-xs normal-case text-gray-200 hover:bg-amber-600 hover:text-white">Planning & Coordination</a>
              <a href="/services/event-decorating/" class="block px-4 py-2 text-xs normal-case text-gray-200 hover:bg-amber-600 hover:text-white">Decorating & Styling</a>
              <a href="/services/event-catering/" class="block px-4 py-2 text-xs normal-case text-gray-200 hover:bg-amber-600 hover:text-white">Food & Catering</a>
              <a href="/services/event-photography/" class="block px-4 py-2 text-xs normal-case text-gray-200 hover:bg-amber-600 hover:text-white">Photography</a>
            </div>
          </div>
        </div>

        <a href="/contact/" class="hover:text-amber-500 transition-colors">CONTACT</a>
      </nav>

      <!-- Desktop Call To Action -->
      <div class="hidden lg:flex items-center">
        <a 
          href="/contact/" 
          class="bg-gold-on-blue hover:bg-[#b07d28] text-white font-bold px-5 py-3 rounded text-xs tracking-wider uppercase shadow-md transition-all"
        >
          REQUEST EVENT SUPPORT
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="lg:hidden flex items-center">
        <button 
          id="mobile-menu-button" 
          type="button" 
          class="text-gray-300 hover:text-white focus:outline-none p-2"
          aria-label="Toggle navigation menu"
        >
          <svg id="hamburger-icon" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="h-7 w-7 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu" class="hidden lg:hidden bg-[#07162c] border-t border-gray-800 px-4 pt-4 pb-6 space-y-3 font-semibold text-sm tracking-wider uppercase">
    <a href="/" class="block text-slate-100 hover:text-amber-500 py-2">HOME</a>
    
    <!-- Mobile About Us Accordion -->
    <div>
      <button 
        id="mobile-about-button" 
        class="w-full flex items-center justify-between text-slate-100 hover:text-amber-500 py-2 focus:outline-none"
      >
        <span>ABOUT US</span>
        <svg id="about-arrow" class="w-4 h-4 transform transition-transform" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </button>
      <div id="mobile-about-dropdown" class="hidden pl-4 space-y-2 py-2 normal-case font-normal text-gray-300">
        <a href="/about/" class="block py-1 hover:text-white">About Us</a>
        <a href="/upcoming-events/" class="block py-1 hover:text-white">Upcoming Events</a>
        <a href="/past-events/" class="block py-1 hover:text-white">Past Events</a>
      </div>
    </div>

    <!-- Mobile Services Accordion -->
    <div>
      <button 
        id="mobile-services-button" 
        class="w-full flex items-center justify-between text-slate-100 hover:text-amber-500 py-2 focus:outline-none"
      >
        <span>SERVICES</span>
        <svg id="services-arrow" class="w-4 h-4 transform transition-transform" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </button>
      <div id="mobile-services-dropdown" class="hidden pl-4 space-y-2 py-2 normal-case font-normal text-gray-300">
        <a href="/services/event-planning/" class="block py-1 hover:text-white">Planning & Coordination</a>
        <a href="/services/event-decorating/" class="block py-1 hover:text-white">Decorating & Styling</a>
        <a href="/services/event-catering/" class="block py-1 hover:text-white">Food & Catering</a>
        <a href="/services/event-photography/" class="block py-1 hover:text-white">Photography</a>
      </div>
    </div>

    <a href="/contact/" class="block text-slate-100 hover:text-amber-500 py-2">CONTACT</a>
    
    <div class="pt-4">
      <a 
        href="/contact/" 
        class="block text-center bg-[#c89234] hover:bg-[#b07d28] text-white font-bold py-3 rounded text-xs tracking-wider uppercase shadow-md"
      >
        REQUEST EVENT SUPPORT
      </a>
    </div>
  </div>
</header>

<script>
  // Mobile main menu toggle
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  menuButton?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
    hamburgerIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });

  // Mobile About Us dropdown toggle
  const aboutBtn = document.getElementById('mobile-about-button');
  const aboutDropdown = document.getElementById('mobile-about-dropdown');
  const aboutArrow = document.getElementById('about-arrow');

  aboutBtn?.addEventListener('click', () => {
    aboutDropdown?.classList.toggle('hidden');
    aboutArrow?.classList.toggle('rotate-180');
  });

  // Mobile Services dropdown toggle
  const servicesBtn = document.getElementById('mobile-services-button');
  const servicesDropdown = document.getElementById('mobile-services-dropdown');
  const servicesArrow = document.getElementById('services-arrow');

  servicesBtn?.addEventListener('click', () => {
    servicesDropdown?.classList.toggle('hidden');
    servicesArrow?.classList.toggle('rotate-180');
  });
</script>