---
import Socials from './Socials.astro';
import '../styles/global.css';  
---

<footer class="bg-[#030e1e] text-white border-t border-[#c89234]/30 pt-12 pb-6">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 lg:gap-6 pb-12 ">
      
      <!-- Column 1: Logo & Brand Tagline -->
      <div class="lg:col-span-2 flex items-start">
        <a href="/" class="flex items-center gap-3 group">
          <img 
            src="/Illinois-event-management-logo.svg" 
            alt="Illinois Event Management Company Logo" 
            class="h-12 w-auto brightness-0 invert opacity-80 group-hover:opacity-100 transition-opacity" 
          />
          <div class="flex flex-col text-left">
            <span class="font-serif text-xl font-black tracking-widest text-white leading-none">
              ILLINOIS
            </span>
            <span class="text-[10px] font-bold tracking-wider text-[#c89234] uppercase mt-0.5 leading-none">
              EVENT MANAGEMENT COMPANY
            </span>
            <div class="flex items-center gap-1 mt-1">
              <span class="h-[1px] w-3 bg-[#c89234]"></span>
              <span class="text-[8px] font-lg text-gray-200 tracking-tight leading-none">
                Your Event, Our Responsibility
              </span>
              <span class="h-[1px] w-3 bg-[#c89234]"></span>
            </div>
          </div>
        </a>
      </div>

      

      <!-- Column 3: Services -->
      <div class="lg:border-l lg:border-[#c89234]/30 lg:pl-6">
        <h3 class="text-xs font-bold tracking-wider uppercase text-[#c89234] mb-4">
          SERVICES
        </h3>
        <ul class="space-y-2 text-xs font-medium text-slate-100">
          <li><a href="/services/event-planning/" class="hover:text-amber-500 transition-colors">Planning & Coordination</a></li>
          <li><a href="/services/catering" class="hover:text-amber-500 transition-colors">Decorating & Styling</a></li>
          <li><a href="/services/setup" class="hover:text-amber-500 transition-colors">Food & Catering</a></li>
        </ul>
      </div>

      <!-- Column 4: Contact Us -->
      <div class="lg:border-l lg:border-[#c89234]/30 lg:pl-6">
        <h3 class="text-xs font-bold tracking-wider uppercase text-[#c89234] mb-4">
          CONTACT US
        </h3>
        <ul class="space-y-3 text-xs font-medium text-slate-100">
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[#c89234] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span>Serving Clients Across Illinois</span>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[#c89234] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <a href="tel:7731234567" class="hover:text-amber-500 transition-colors">(773) 123-4567</a>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[#c89234] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <a href="mailto:info@illinoiseventmc.com" class="hover:text-amber-500 transition-colors">info@illinoiseventmc.com</a>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[#c89234] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
            </svg>
            <a href="https://www.illinoiseventmc.com" class="hover:text-amber-500 transition-colors">www.illinoiseventmc.com</a>
          </li>
        </ul>
      </div>

      <!-- Column 5: Follow Us -->
      <div class="lg:border-l lg:border-[#c89234]/30 lg:pl-6">
        <h3 class="text-xs font-bold tracking-wider uppercase text-[#c89234] mb-4">
          FOLLOW US
        </h3>
       <Socials></Socials> 
      </div>

    </div>

    <!-- Bottom Copyright Bar -->
    <div class="border-t border-gray-800/80 pt-6 text-center">
      <p class="text-[11px] text-gray-400">
        © {new Date().getFullYear()} Illinois Event Management Company. All Rights Reserved.
      </p>
    </div>
  </div>
</footer>