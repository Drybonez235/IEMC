---
import '../styles/global.css';  
---

<section class="bg-[#030e1e] border-y border-[#c89234]/30 py-6">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-4">
    
    <!-- Left Side: Icon + Headline & Subtitle -->
    <div class="flex items-center gap-4 text-center md:text-left">
      <!-- Calendar Icon -->
      <div class="shrink-0 hidden sm:block">
        <svg class="w-10 h-10 text-[#c89234]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>

      <!-- Text Container -->
      <div>
        <h2 class="text-white font-bold text-lg sm:text-xl tracking-tight leading-snug">
          Let's create an unforgettable experience together.
        </h2>
        <p class="text-gray-300 text-xs sm:text-sm font-normal mt-0.5">
          Tell us about your event and how we can support you.
        </p>
      </div>
    </div>

    <!-- Right Side: CTA Button -->
    <div class="shrink-0 w-full md:w-auto mt-2 md:mt-0">
      <a 
        href="/contact" 
        class="inline-flex items-center justify-center gap-2 w-full md:w-auto bg-[#c89234] hover:bg-[#b07d28] text-white font-bold px-6 py-3 rounded text-xs tracking-wider uppercase shadow-md transition-colors"
      >
        <span>GET IN TOUCH TODAY</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

  </div>
</section>