---
import '../styles/global.css'
---

<section class="py-8 px-4 max-w-7xl mx-auto">
  <div class="bg-[#07162c] text-white rounded-xl p-6 md:py-8 md:px-10 flex flex-col lg:flex-row items-center justify-between gap-6 border border-slate-800 shadow-xl">
    
    <div class="flex items-center gap-5 w-full lg:w-auto">
      <div class="flex-shrink-0 w-16 h-16 rounded-full border-2 border-gold-on-blue/80 flex items-center justify-center bg-transparent">
        <svg class="w-8 h-8 stroke-gold-on-blue" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5m-9-6h.008v.008H12v-.008zM12 15h.008v.008H12V15zm0 3h.008v.008H12V18z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75l2.25 2.25 4.5-4.5" />
        </svg>
      </div>
      <div>
        <h3 class="text-xl md:text-2xl font-bold tracking-tight text-white leading-tight">
          Let us plan your next successful event.
        </h3>
        <p class="text-sm text-slate-300 mt-1">
          We take care of the details, you enjoy the moments.
        </p>
      </div>
    </div>

    <div class="flex items-center gap-8 w-full lg:w-auto justify-between lg:justify-start border-t lg:border-t-0 lg:border-l border-slate-700/60 pt-6 lg:pt-0 lg:pl-8">
      <a 
        href="/contact/" 
        class="inline-flex items-center justify-center gap-2 bg-gradient-to-r from-gold-on-blue to-gold-on-blue hover:from-gold-on-blue hover:to-amber-400 text-white font-semibold text-xs tracking-wider uppercase py-3.5 px-6 rounded-md shadow-md hover:shadow-lg transition-all duration-200 group whitespace-nowrap"
      >
        <span>LET'S PLAN YOUR EVENT</span>
        <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>

    <div class="flex flex-col justify-center gap-2.5 w-full lg:w-auto border-t lg:border-t-0 lg:border-l border-slate-700/60 pt-6 lg:pt-0 lg:pl-8 text-sm text-slate-200">
      <a href="tel:7731234567" class="flex items-center gap-3 hover:text-amber-400 transition-colors duration-150">
       <svg class="w-5 h-5 stroke-gold-on-blue flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.826-1.23-5.228-3.632-6.457-6.457l1.293-.97c.362-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
        </svg>
        <span class="font-medium tracking-wide">(773) 123-4567</span>
      </a>
      <a href="mailto:info@illinoiseventmanagement.com class="flex items-center gap-3 hover:text-amber-400 transition-colors duration-150">
        <svg class="w-5 h-5 stroke-gold-on-blue flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25H4.5a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5H4.5a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
        </svg>
        <span class="font-medium tracking-wide">info@illinoiseventmanagement.com</span>
      </a>
    </div>

  </div>
</section>