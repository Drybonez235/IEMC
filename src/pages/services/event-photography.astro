  },
  {
    title: 'Photo Delivery Support',
    description: 'We follow up and assist in the delivery of your photos in the format you prefer.',
    icon: `<svg class="w-10 h-10 stroke-gold-on-blue" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" /></svg>`
  },
  {
    title: 'Backup & Storage Guidance',
    description: 'We provide guidance on safe delivery and storage options for your precious memories.',
    icon: `<svg class="w-10 h-10 stroke-gold-on-blue" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V9.75m0 0l3 3m-3-3l-3 3M6.75 19.5a4.5 4.5 0 01-1.41-8.775 5.25 5.25 0 0110.233-2.33 3 3 0 013.758 3.848A3.752 3.752 0 0118 19.5H6.75z" /></svg>`
  }
];
---
<BaseLayout 
  title="Illinois Event Management Company: Event Photography" 
  description="We provide flexible event management and event support services to organizations and individuals throughout the Chicago area."
  image="/favicon.svg"
>

<section class="relative bg-[#030e1e] min-h-[520px] lg:min-h-[600px] flex items-center overflow-hidden">
  <!-- Background Image with Dark Gradient Overlay -->
  <div class="absolute inset-0 z-0 from-brand-navy to-brand-navy-light ">
    <img 
      src="/illinois-event-management-company-photograhy-hero-image.avif" 
      alt="People laughing at an event clapping with glee" 
      class="w-full h-full object-cover object-right lg:object-center"
      height="1536"
      width="2816"
    />
    <!-- Gradient overlay: solid dark blue on the left fading out to reveal the crowd photo on the right -->
    <div class="absolute inset-0 bg-gradient-to-r from-[#030e1e] via-[#030e1e]/90 to-transparent lg:to-[#030e1e]/20"></div>
  </div>

  <!-- Hero Content Container -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 w-full">
    <div class="max-w-2xl">
      
      <!-- Primary Headline -->
      <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-[1.15]">
        Photography <br />
        <span class="text-[#c89234]">Coordination</span>
      </h1>

      <!-- Gold Divider Accent Line -->
      <div class="w-32 h-[2px] bg-[#c89234] my-6"></div>

      <!-- Subheadline -->
      <p class="text-lg sm:text-xl text-gray-200 font-light leading-relaxed">
        Capturing every moment <br> 
        <span class="text-[#c89234] font-semibold">that matters.</span>
      </p>

      <!-- Action Buttons -->
      <div class="mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
        
        <!-- Primary Button -->
        <a 
          href="/contact/" 
          class="inline-flex items-center justify-center gap-2 bg-[#c89234] hover:bg-[#b07d28] text-white font-bold px-6 py-3.5 rounded text-xs tracking-wider uppercase shadow-lg transition-all"
        >
          <span>REQUEST EVENT SUPPORT</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

        <!-- Secondary Outline Button -->
        <a 
          href="#photo-options" 
          class="inline-flex items-center justify-center gap-2 border-2 border-[#c89234] hover:bg-[#c89234]/10 text-white font-bold px-6 py-3 rounded text-xs tracking-wider uppercase transition-all"
        >
          <span>See photo options</span>
          <svg class="w-4 h-4 text-[#c89234]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

      </div>

    </div>
  </div>
</section>
<section class="py-12 px-4 max-w-7xl mx-auto">
  <div class="bg-[#FDFBF7] border border-stone-200 rounded-2xl p-6 md:p-8 shadow-sm">
    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-8 lg:gap-4 divide-y md:divide-y-0 lg:divide-x divide-stone-200">
      {features.map((item, index) => (
        <div class={`flex flex-col items-center text-center px-4 ${index !== 0 ? 'pt-6 lg:pt-0' : ''}`}>
          <div class="w-16 h-16 rounded-full bg-[#0E1A2B] flex items-center justify-center mb-6 shadow-md">
            <Fragment set:html={item.icon} />
          </div>
          <h3 class="text-sm font-bold tracking-wider text-[#0E1A2B] mb-3 uppercase">
            {item.title}
          </h3>
          <p class="text-xs text-stone-600 leading-relaxed max-w-[220px]">
            {item.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
<CallToActionBanner></CallToActionBanner>
<section id="photo-options" class="py-16 px-4 max-w-7xl mx-auto text-center">
  <div class="mb-12">
    <h3 class="text-xs font-bold uppercase tracking-widest text-gold-on-blue mb-2">
      OUR PHOTOGRAPHY COORDINATION SERVICES
    </h3>
    <h2 class="text-3xl md:text-4xl font-serif text-[#0E1A2B] font-semibold mb-3">
      Every Moment. Beautifully Captured.
    </h2>
    <div class="w-12 h-0.5 bg-gold-on-blue mx-auto"></div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-4">
    {services.map((item) => (
      <div class="bg-[#FDFBF7] border border-stone-200/80 rounded-xl p-6 flex flex-col items-center text-center shadow-sm hover:shadow-md transition-shadow duration-200">
        <div class="mb-6 flex items-center justify-center h-12 w-12">
          <Fragment set:html={item.icon} />
        </div>
        <h4 class="text-base font-bold text-[#0E1A2B] mb-3 leading-snug">
          {item.title}
        </h4>
        <p class="text-xs text-stone-600 leading-relaxed">
          {item.description}
        </p>
      </div>
    ))}
  </div>
</section>
<CallToActionCard></CallToActionCard>  
</BaseLayout>