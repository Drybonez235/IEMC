---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CallToActionBanner from "../../components/CallToActionBanner.astro";
import "../../styles/global.css";
---

<BaseLayout
  title="Illinois Event Management Company: Event Planning"
  description="We provide flexible event management and event support services to organizations and individuals throughout the Chicago area."
  image="/favicon.svg"
>
<section class="relative min-h-[520px] lg:min-h-[600px] flex items-center overflow-hidden">
      <div class="absolute inset-0 z-0 from-brand-navy to-brand-navy-light">
        <img 
          src="/Illinois-event-managment-company-work-together.avif" 
          alt="Hands working on event timeline planning document" 
          class="w-full h-full object-cover object-right lg:object-center"
          height="1536"
        width="2816"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-[#030e1e] via-[#030e1e]/40 to-transparent lg:to-[#030e1e]/10"></div>
      </div>

      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 w-full">
        <div class="max-w-2xl">
          
          <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-[1.15]">
            Event Planning & <br />
            <span class="text-[#c89234]">Coordination</span>
          </h1>

          <div class="w-32 h-[2px] bg-[#c89234] my-6"></div>

          <p class="text-lg sm:text-xl text-gray-200 font-light leading-relaxed">
            From the first idea to the final detail, we plan, organize, and manage every aspect of your event so you can relax and enjoy the success.
          </p>

          <div class="mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
            
            <a 
              href="/contact/" 
              class="inline-flex items-center justify-center gap-2 bg-[#c89234] hover:bg-[#b07d28] text-white font-bold px-6 py-3.5 rounded text-xs tracking-wider uppercase shadow-lg transition-all"
            >
              <span>PLAN YOUR EVENT</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>

            <a 
              href="#services" 
              class="inline-flex items-center justify-center gap-2 border-2 border-[#c89234] hover:bg-[#c89234]/10 text-white font-bold px-6 py-3 rounded text-xs tracking-wider uppercase transition-all"
            >
              <span>EXPLORE ALL SERVICES</span>
              <svg class="w-4 h-4 text-[#c89234]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>

          </div>

        </div>
      </div>
    </section>

    <section class="border-t border-slate-800 bg-[#020914] relative z-10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6 lg:gap-4 divide-y sm:divide-y-0 sm:divide-x divide-slate-800/60">
          
          <div class="flex items-start gap-3 pt-4 sm:pt-0 sm:px-3">
            <div class="text-[#c89234] shrink-0">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-sm text-white">End-to-End Planning</h3>
              <p class="text-xs text-slate-400 mt-1">We handle every detail from start to finish.</p>
            </div>
          </div>

          <div class="flex items-start gap-3 pt-4 sm:pt-0 sm:px-3">
            <div class="text-[#c89234] shrink-0">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-sm text-white">Stress-Free Experience</h3>
              <p class="text-xs text-slate-400 mt-1">We take care of the details so you can focus on guests.</p>
            </div>
          </div>

          <div class="flex items-start gap-3 pt-4 sm:pt-0 sm:px-3">
            <div class="text-[#c89234] shrink-0">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-sm text-white">Experienced Team</h3>
              <p class="text-xs text-slate-400 mt-1">Skilled professionals with a passion for perfection.</p>
            </div>
          </div>

          <div class="flex items-start gap-3 pt-4 sm:pt-0 sm:px-3">
            <div class="text-[#c89234] shrink-0">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-sm text-white">On-Time, Every Time</h3>
              <p class="text-xs text-slate-400 mt-1">Reliable planning and execution you can count on.</p>
            </div>
          </div>

          <div class="flex items-start gap-3 pt-4 sm:pt-0 sm:px-3">
            <div class="text-[#c89234] shrink-0">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-sm text-white">Customized for You</h3>
              <p class="text-xs text-slate-400 mt-1">Tailored solutions matching your goals and budget.</p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <section  class="bg-[#FDFBF7] py-8 px-4 sm:px-6 lg:px-8 border-t border-stone-200">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-stretch">
      
      <!-- Left Column: Intro & CTA -->
      <div class="lg:col-span-4 flex flex-col justify-between pr-0 lg:pr-8 lg:border-r lg:border-stone-300">
        <div>
          <!-- Sub-header -->
          <span class="text-xs font-bold uppercase tracking-wider text-[#c89234] block mb-2">
            WHAT WE DO
          </span>

          <!-- Main Headline -->
          <h2 class="font-serif text-3xl sm:text-2xl font-bold text-[#030e1e] leading-tight mb-4">
            Thoughtful Planning. <br />
            Flawless Execution.
          </h2>

          <div class="w-16 h-[2px] bg-[#c89234] mb-6"></div>

          <!-- Description -->
          <p class="text-stone-600 text-sm leading-relaxed mb-8">
            We believe every event is unique. Our planning process is built around your goals, style, and vision—delivered with precision and care.
          </p>
        </div>

        <!-- Call to Action Button -->
        <div>
          <a
            href="/contact/"
            class="inline-flex items-center justify-center gap-2 bg-[#c89234] hover:bg-[#b07d28] text-white font-bold px-6 py-3.5 rounded text-xs tracking-wider uppercase shadow-sm transition-all w-full sm:w-auto"
          >
            <span>REQUEST EVENT SUPPORT</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Right Column: Step-by-Step Process Timeline -->
      <div class="lg:col-span-8 flex flex-col justify-center">
        
        <!-- Section Divider Header -->
        <div class="flex items-center gap-4 mb-12">
          <div class="h-[1px] bg-stone-300 flex-grow"></div>
          <h3 class="text-xs font-bold uppercase tracking-widest text-[#c89234]">
            OUR PLANNING PROCESS
          </h3>
          <div class="h-[1px] bg-stone-300 flex-grow"></div>
        </div>

        <!-- 5-Step Process Grid -->
        <div class="relative grid grid-cols-1 sm:grid-cols-2 md:grid-cols-5 gap-8 md:gap-4">
          
          <!-- Horizontal Connecting Dotted Line (Desktop Only) -->
          <div class="hidden md:block absolute top-7 left-[10%] right-[10%] h-[2px] border-t-2 border-dashed border-sky-800 z-0"></div>

          <!-- Step 1 -->
          <div class="relative z-10 flex flex-col items-center text-center group">
            <div class="w-14 h-14 rounded-full bg-[#030e1e] text-white flex items-center justify-center shadow-md mb-3">
              <!-- Consultation Icon -->
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
              </svg>
            </div>
            <div class="w-6 h-6 rounded-full bg-[#c89234] text-white text-xs font-bold flex items-center justify-center mb-3">
              1
            </div>
            <h4 class="font-bold text-xs uppercase text-[#030e1e] tracking-wider mb-2">
              CONSULTATION
            </h4>
            <p class="text-xs text-stone-600 leading-relaxed max-w-[160px]">
              We listen to your ideas, needs, and expectations to understand your vision.
            </p>
          </div>

          <!-- Step 2 -->
          <div class="relative z-10 flex flex-col items-center text-center group">
            <div class="w-14 h-14 rounded-full bg-[#030e1e] text-white flex items-center justify-center shadow-md mb-3">
              <!-- Planning Icon -->
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
              </svg>
            </div>
            <div class="w-6 h-6 rounded-full bg-[#c89234] text-white text-xs font-bold flex items-center justify-center mb-3">
              2
            </div>
            <h4 class="font-bold text-xs uppercase text-[#030e1e] tracking-wider mb-2">
              PLANNING & STRATEGY
            </h4>
            <p class="text-xs text-stone-600 leading-relaxed max-w-[160px]">
              We develop a customized plan, timeline, and budget tailored to your event.
            </p>
          </div>

          <!-- Step 3 -->
          <div class="relative z-10 flex flex-col items-center text-center group">
            <div class="w-14 h-14 rounded-full bg-[#030e1e] text-white flex items-center justify-center shadow-md mb-3">
              <!-- Coordination Icon -->
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
            <div class="w-6 h-6 rounded-full bg-[#c89234] text-white text-xs font-bold flex items-center justify-center mb-3">
              3
            </div>
            <h4 class="font-bold text-xs uppercase text-[#030e1e] tracking-wider mb-2">
              COORDINATION
            </h4>
            <p class="text-xs text-stone-600 leading-relaxed max-w-[160px]">
              We coordinate vendors, logistics, and every detail to ensure everything is in place.
            </p>
          </div>

          <!-- Step 4 -->
          <div class="relative z-10 flex flex-col items-center text-center group">
            <div class="w-14 h-14 rounded-full bg-[#030e1e] text-white flex items-center justify-center shadow-md mb-3">
              <!-- Execution Icon -->
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <div class="w-6 h-6 rounded-full bg-[#c89234] text-white text-xs font-bold flex items-center justify-center mb-3">
              4
            </div>
            <h4 class="font-bold text-xs uppercase text-[#030e1e] tracking-wider mb-2">
              EXECUTION
            </h4>
            <p class="text-xs text-stone-600 leading-relaxed max-w-[160px]">
              Our team manages the event on-site so everything runs smoothly.
            </p>
          </div>

          <!-- Step 5 -->
          <div class="relative z-10 flex flex-col items-center text-center group">
            <div class="w-14 h-14 rounded-full bg-[#030e1e] text-white flex items-center justify-center shadow-md mb-3">
              <!-- Follow-Up Icon -->
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
              </svg>
            </div>
            <div class="w-6 h-6 rounded-full bg-[#c89234] text-white text-xs font-bold flex items-center justify-center mb-3">
              5
            </div>
            <h4 class="font-bold text-xs uppercase text-[#030e1e] tracking-wider mb-2">
              FOLLOW-UP
            </h4>
            <p class="text-xs text-stone-600 leading-relaxed max-w-[160px]">
              We review the event with you and ensure complete satisfaction.
            </p>
          </div>

        </div>

      </div>

    </div>
  </div>
</section>

  <CallToActionBanner></CallToActionBanner>

<section id="services" class="bg-[#FDFBF7] py-8 px-4 sm:px-6 lg:px-8 border-t border-stone-200">
  <div class="max-w-7xl mx-auto">
    <!-- Grid Container: Stacked on mobile, 50/50 Side-by-Side on Desktop -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
      
      <!-- Left Card: Included Features -->
      <div class="lg:col-span-6 bg-[#F8F5EE] rounded-xl p-6 sm:p-8 flex flex-col justify-between border border-stone-200/60 shadow-sm">
        <div>
          <!-- Header -->
          <h3 class="text-xs font-bold uppercase tracking-widest text-[#c89234] text-center mb-8">
            INCLUDED IN OUR PLANNING & COORDINATION
          </h3>

          <!-- 2-Column Checklist Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-5 gap-x-4">
            
            <!-- Item 1 -->
            <div class="flex items-start gap-3">
              <div class="text-[#c89234] shrink-0 mt-0.5">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <span class="text-xs sm:text-sm text-stone-700 font-medium">Event concept & theme development</span>
            </div>

            <!-- Item 2 -->
            <div class="flex items-start gap-3">
              <div class="text-[#c89234] shrink-0 mt-0.5">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <span class="text-xs sm:text-sm text-stone-700 font-medium">Logistics & venue coordination</span>
            </div>

            <!-- Item 3 -->
            <div class="flex items-start gap-3">
              <div class="text-[#c89234] shrink-0 mt-0.5">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <span class="text-xs sm:text-sm text-stone-700 font-medium">Timeline & schedule management</span>
            </div>

            <!-- Item 4 -->
            <div class="flex items-start gap-3">
              <div class="text-[#c89234] shrink-0 mt-0.5">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <span class="text-xs sm:text-sm text-stone-700 font-medium">Permits, licenses & compliance support</span>
            </div>

            <!-- Item 5 -->
            <div class="flex items-start gap-3">
              <div class="text-gold-on-blue shrink-0 mt-0.5">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <span class="text-xs sm:text-sm text-stone-700 font-medium">Vendor selection & coordination</span>
            </div>

            <!-- Item 6 -->
            <div class="flex items-start gap-3">
              <div class="text-[#c89234] shrink-0 mt-0.5">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <span class="text-xs sm:text-sm text-stone-700 font-medium">On-site management & supervision</span>
            </div>

            <!-- Item 7 -->
            <div class="flex items-start gap-3">
              <div class="text-[#c89234] shrink-0 mt-0.5">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <span class="text-xs sm:text-sm text-stone-700 font-medium">Budget planning & management</span>
            </div>

            <!-- Item 8 -->
            <div class="flex items-start gap-3">
              <div class="text-[#c89234] shrink-0 mt-0.5">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <span class="text-xs sm:text-sm text-stone-700 font-medium">Post-event review & feedback</span>
            </div>

          </div>
        </div>
      </div>

      <!-- Right Card: CTA Banner -->
      <div class="lg:col-span-6 relative rounded-xl overflow-hidden min-h-[320px] flex items-center justify-end p-6 sm:p-10 shadow-md">
        <!-- Background Image -->
        <img 
          src="/illinois-event-management-company-fancy-event-fairly-lights.avif" 
          alt="Event hall setting" 
          class="absolute inset-0 w-full h-full object-cover z-0"
        />
        
        <!-- Dark Navy Overlay Gradient: Transparent on left, Solid Navy on right -->
        <div class="absolute inset-0 bg-gradient-to-r from-[#030e1e]/50 via-[#030e1e]/70 to-[#030e1e] z-10"></div>

        <!-- Content Box positioned on the right -->
        <div class="relative z-20 max-w-md text-left flex flex-col items-start">
          
         

          <!-- Headline -->
          <h3 class="font-serif text-2xl sm:text-3xl font-bold text-white leading-tight mb-2">
            Let us plan your next <br />
            successful event.
          </h3>

          <!-- Accent Line -->
          <div class="w-16 h-[2px] bg-[#c89234] my-3"></div>

          <!-- Paragraph -->
          <p class="text-xs sm:text-sm text-stone-300 leading-relaxed mb-6">
            Contact us today to discuss your event and how we can make it an unforgettable experience.
          </p>

          <!-- Button -->
          <a
            href="/contact/"
            class="inline-flex items-center justify-center gap-2 bg-[#c89234] hover:bg-[#b07d28] text-white font-bold px-6 py-3.5 rounded text-xs tracking-wider uppercase shadow-md transition-all"
          >
            <span>GET IN TOUCH</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

        </div>
      </div>

    </div>
  </div>
</section>
</BaseLayout>
