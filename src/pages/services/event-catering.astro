---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CallToActionBanner from "../../components/CallToActionBanner.astro";
import "../../styles/global.css";
---

<BaseLayout
  title="Illinois Event Management Company: Event Catering"
  description="We provide flexible event management and event support services to organizations and individuals throughout the Chicago area."
  image="/favicon.svg"
>
  <section class="relative bg-[#030e1e] min-h-[520px] lg:min-h-[600px] flex items-center overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img
        src="/illinois-event-management-company-catering.avif"
        alt="Catering and food service presentation at an event"
        class="w-full h-full object-cover object-right lg:object-center"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-[#030e1e] via-[#030e1e]/60 to-transparent lg:to-[#030e1e]/30"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 w-full">
      <div class="max-w-2xl">
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-[1.15]">
          Catering & <br />
          <span class="text-[#c89234]">Food Services</span>
        </h1>

        <div class="w-32 h-[2px] bg-[#c89234] my-6"></div>

        <p class="text-lg sm:text-xl text-gray-200 font-light leading-relaxed">
          Delicious food. Professional service. Memorable experience. <br />
          <span class="text-[#c89234] font-semibold">
            Our catering solutions are designed to match your event, your guests, and your vision.
          </span>
        </p>

        <div class="mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
          <a
            href="/request-support"
            class="inline-flex items-center justify-center gap-2 bg-[#c89234] hover:bg-[#b07d28] text-white font-bold px-6 py-3.5 rounded text-xs tracking-wider uppercase shadow-lg transition-all"
          >
            <span>REQUEST EVENT SUPPORT</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>

          <a
            href="/services"
            class="inline-flex items-center justify-center gap-2 border-2 border-[#c89234] hover:bg-[#c89234]/10 text-white font-bold px-6 py-3 rounded text-xs tracking-wider uppercase transition-all"
          >
            <span>EXPLORE OUR SERVICES</span>
            <svg class="w-4 h-4 text-[#c89234]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="bg-[#f2ebd9]/60 rounded-2xl p-6 sm:p-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6 sm:gap-4">
        
        <div class="flex flex-col items-center text-center sm:px-2">
          <div class="w-16 h-16 rounded-full bg-[#030e1e] text-[#c89234] flex items-center justify-center shadow-md mb-4 shrink-0">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
              <path d="M12 5a1 1 0 100-2 1 1 0 000 2z"></path>
              <path d="M4 15a8 8 0 0116 0H4z"></path>
              <path d="M2 18h20"></path>
            </svg>
          </div>
          <h3 class="font-bold text-xs sm:text-sm tracking-wider uppercase text-[#030e1e] mb-2">
            Customized Menus
          </h3>
          <p class="text-xs text-stone-600 leading-relaxed max-w-[200px]">
            Menus tailored to your event, preferences, and dietary needs.
          </p>
        </div>

        <div class="flex flex-col items-center text-center sm:px-2">
          <div class="w-16 h-16 rounded-full bg-[#030e1e] text-[#c89234] flex items-center justify-center shadow-md mb-4 shrink-0">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
              <path d="M6 13.8a4.5 4.5 0 11.9-8.7 5 5 0 019.2 0 4.5 4.5 0 11.9 8.7H6z"></path>
              <path d="M6 14h12v4H6z"></path>
            </svg>
          </div>
          <h3 class="font-bold text-xs sm:text-sm tracking-wider uppercase text-[#030e1e] mb-2">
            Fresh & Quality
          </h3>
          <p class="text-xs text-stone-600 leading-relaxed max-w-[200px]">
            We use quality ingredients to deliver great taste and presentation.
          </p>
        </div>

        <div class="flex flex-col items-center text-center sm:px-2">
          <div class="w-16 h-16 rounded-full bg-[#030e1e] text-[#c89234] flex items-center justify-center shadow-md mb-4 shrink-0">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
              <path d="M17 21v-2a4 4 0 00-4-4H11a4 4 0 00-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
              <path d="M22 21v-2a4 4 0 00-3-3.87"></path>
              <path d="M16 3.13a4 4 0 010 7.75"></path>
            </svg>
          </div>
          <h3 class="font-bold text-xs sm:text-sm tracking-wider uppercase text-[#030e1e] mb-2">
            Professional Service
          </h3>
          <p class="text-xs text-stone-600 leading-relaxed max-w-[200px]">
            Our team ensures on-time service, food setup, and guest satisfaction.
          </p>
        </div>

        <div class="flex flex-col items-center text-center sm:px-2">
          <div class="w-16 h-16 rounded-full bg-[#030e1e] text-[#c89234] flex items-center justify-center shadow-md mb-4 shrink-0">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
              <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2"></path>
              <rect x="9" y="3" width="6" height="4" rx="1"></rect>
              <path d="M12 11l2 2 4-4"></path>
            </svg>
          </div>
          <h3 class="font-bold text-xs sm:text-sm tracking-wider uppercase text-[#030e1e] mb-2">
            Food Safety
          </h3>
          <p class="text-xs text-stone-600 leading-relaxed max-w-[200px]">
            We follow food safety standards for a clean and safe experience.
          </p>
        </div>

        <div class="flex flex-col items-center text-center sm:px-2">
          <div class="w-16 h-16 rounded-full bg-[#030e1e] text-[#c89234] flex items-center justify-center shadow-md mb-4 shrink-0">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
              <path d="M2 22s2.5-1.5 4.8-4.5c2.3-3 4.2-7.5 4.2-12.5C6 5 1.5 6.9 1.5 9.2c0 2.3 1.5 4.8 4.5 4.8"></path>
              <path d="M22 22s-2.5-1.5-4.8-4.5c-2.3-3-4.2-7.5-4.2-12.5C18 5 22.5 6.9 22.5 9.2c0 2.3-1.5 4.8-4.5 4.8"></path>
            </svg>
          </div>
          <h3 class="font-bold text-xs sm:text-sm tracking-wider uppercase text-[#030e1e] mb-2">
            Flexible Options
          </h3>
          <p class="text-xs text-stone-600 leading-relaxed max-w-[200px]">
            From small gatherings to large events — we've got you covered.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- WHAT WE OFFER SECTION -->
<section class="relative bg-[#f8f5ee] py-16 px-4 sm:px-6 lg:px-8 overflow-hidden">
  
  <!-- Section Header -->
  <div class="text-center max-w-3xl mx-auto mb-12">
    <span class="text-[#c89234] font-bold text-xs sm:text-sm tracking-widest uppercase block mb-1">
      WHAT WE OFFER
    </span>
    <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#030e1e]">
      Catering for Every Occasion
    </h2>
    <div class="w-12 h-[2px] bg-[#c89234] mx-auto mt-3"></div>
  </div>

  <!-- Content Grid Container -->
  <div class="max-w-7xl mx-auto relative z-10 pb-48 lg:pb-56">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
      
      <!-- Left Box: PERFECT FOR -->
      <div class="lg:col-span-3 bg-[#f2ebd9]/70 rounded-2xl p-6 sm:p-8 flex flex-col justify-center border border-[#e5dac1]/50 shadow-sm">
        <h3 class="font-bold text-xs sm:text-sm tracking-widest uppercase text-[#c89234] text-center mb-6">
          PERFECT FOR
        </h3>
        <ul class="space-y-4">
          <li class="flex items-center gap-3 text-xs sm:text-sm font-semibold text-[#030e1e]">
            <span class="w-5 h-5 rounded-full bg-[#c89234] text-white flex items-center justify-center text-[10px] shrink-0 font-bold">✓</span>
            <span>Corporate Meetings & Conferences</span>
          </li>
          <li class="flex items-center gap-3 text-xs sm:text-sm font-semibold text-[#030e1e]">
            <span class="w-5 h-5 rounded-full bg-[#c89234] text-white flex items-center justify-center text-[10px] shrink-0 font-bold">✓</span>
            <span>Workshops & Seminars</span>
          </li>
          <li class="flex items-center gap-3 text-xs sm:text-sm font-semibold text-[#030e1e]">
            <span class="w-5 h-5 rounded-full bg-[#c89234] text-white flex items-center justify-center text-[10px] shrink-0 font-bold">✓</span>
            <span>University & School Events</span>
          </li>
          <li class="flex items-center gap-3 text-xs sm:text-sm font-semibold text-[#030e1e]">
            <span class="w-5 h-5 rounded-full bg-[#c89234] text-white flex items-center justify-center text-[10px] shrink-0 font-bold">✓</span>
            <span>Nonprofit & Community Events</span>
          </li>
          <li class="flex items-center gap-3 text-xs sm:text-sm font-semibold text-[#030e1e]">
            <span class="w-5 h-5 rounded-full bg-[#c89234] text-white flex items-center justify-center text-[10px] shrink-0 font-bold">✓</span>
            <span>Weddings & Celebrations</span>
          </li>
          <li class="flex items-center gap-3 text-xs sm:text-sm font-semibold text-[#030e1e]">
            <span class="w-5 h-5 rounded-full bg-[#c89234] text-white flex items-center justify-center text-[10px] shrink-0 font-bold">✓</span>
            <span>Private Parties & Gatherings</span>
          </li>
        </ul>
      </div>

      <!-- Center Cards: 3 Dark Meal Categories -->
      <div class="lg:col-span-6 grid grid-cols-1 sm:grid-cols-3 gap-4">
        
        <!-- Card 1: Morning Selections -->
        <div class="bg-[#030e1e] text-white rounded-2xl p-6 flex flex-col items-center text-center justify-between shadow-md">
          <div class="my-4 text-[#c89234]">
            <svg class="w-12 h-12" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32l1.41-1.41"></path>
            </svg>
          </div>
          <div>
            <h4 class="font-bold text-xs tracking-wider uppercase text-[#c89234] mb-3">
              MORNING SELECTIONS
            </h4>
            <p class="text-xs text-gray-300 leading-relaxed font-light">
              Light bites, pastries, fruits, and beverages to start your day right.
            </p>
          </div>
        </div>

        <!-- Card 2: Lunch / Afternoon / Evening -->
        <div class="bg-[#030e1e] text-white rounded-2xl p-6 flex flex-col items-center text-center justify-between shadow-md">
          <div class="my-4 text-[#c89234]">
            <svg class="w-12 h-12" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path d="M12 5a1 1 0 100-2 1 1 0 000 2z"></path>
              <path d="M4 15a8 8 0 0116 0H4z"></path>
              <path d="M2 18h20"></path>
            </svg>
          </div>
          <div>
            <h4 class="font-bold text-xs tracking-wider uppercase text-[#c89234] mb-3 leading-snug">
              LUNCH / AFTERNOON / EVENING
            </h4>
            <p class="text-xs text-gray-300 leading-relaxed font-light">
              A variety of delicious entrées and meals for any time of your event.
            </p>
          </div>
        </div>
        <!-- Card 3: Sides -->
        <div class="bg-[#030e1e] text-white rounded-2xl p-6 flex flex-col items-center text-center justify-between shadow-md">
          <div class="my-4 text-[#c89234]">
            <!-- Salad Bowl Icon -->
            <svg class="w-12 h-12" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path d="M4 11a8 8 0 0016 0H4z"></path>
              <path d="M12 7V4m-3 3l-1-2m7 2l1-2"></path>
            </svg>
          </div>
          <div>
            <h4 class="font-bold text-xs tracking-wider uppercase text-[#c89234] mb-3">
              SIDES
            </h4>
            <p class="text-xs text-gray-300 leading-relaxed font-light">
              Flavorful sides and accompaniments that complete your perfect meal.
            </p>
          </div>
        </div>


     

      </div>

      <!-- Right Box: BUILD YOUR OWN MENU CTA -->
      <div class="lg:col-span-3 bg-[#f2ebd9]/70 rounded-2xl p-6 sm:p-8 flex flex-col justify-between text-center border border-[#e5dac1]/50 shadow-sm">
        <div>
          <h3 class="font-serif text-xl sm:text-2xl font-bold text-[#030e1e] tracking-tight uppercase leading-snug">
            BUILD YOUR <br /> OWN MENU
          </h3>
          <div class="w-8 h-[2px] bg-[#c89234] mx-auto my-4"></div>
          <p class="text-xs sm:text-sm text-stone-700 leading-relaxed font-normal my-6">
            Mix and match from our selections to create the perfect menu for your event and budget.
          </p>
        </div>

        <a
          href="/menu"
          class="inline-flex items-center justify-center gap-2 bg-[#c89234] hover:bg-[#b07d28] text-white font-bold px-4 py-3.5 rounded-lg text-xs tracking-wider uppercase shadow-md transition-all"
        >
          <span>VIEW CATERING MENU</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
          </svg>
        </a>
      </div>

    </div>
  </div>

  <!-- Bottom Food Decor Background Image -->
  <div class="absolute bottom-0 inset-x-0 w-full h-56 sm:h-64 lg:h-72 pointer-events-none z-0">
    <img
      src="/illinois-event-management-company-food-garnish.avif"
      alt="Fresh ingredients border featuring olives, herbs, pasta, and crackers"
      class="w-full h-full object-cover object-bottom"
    />
  </div>
</section>
</BaseLayout>