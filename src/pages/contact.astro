---
import BaseLayout from "../layouts/BaseLayout.astro";
import CallToActionBanner from "../components/CallToActionBanner.astro";
import "../styles/global.css";
---

<BaseLayout
  title="Illinois Event Management Company: Contact"
  description="We provide flexible event management and event support services to organizations and individuals throughout the Chicago area."
  image="/Illinois-event-management-logo.svg"
>
  <!-- Hero Section -->
  <section class="relative bg-[#051329] text-white py-16 px-6 sm:px-12 lg:px-20 overflow-hidden">
    <!-- Hero Background Image & Dark Overlay -->
    <div class="absolute inset-0 z-0">
      <img 
        src="/illinois-event-management-company-contact-hero.avif" 
        alt="Illinois Event Management Contact Background" 
        class="w-full h-full object-cover object-center"
      />
      <div class="absolute inset-0 bg-[#051329]/85 mix-blend-multiply"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-[#051329] via-[#051329]/90 to-transparent"></div>
    </div>

    <!-- Hero Content Container -->
    <div class="max-w-6xl mx-auto relative z-10 grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
      <!-- Hero Left Side -->
      <div class="md:col-span-7 space-y-4 font-serif">
        <div>
          <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight">
            Contact <span class="text-brand-gold">Information</span>
          </h1>
          <div class="w-16 h-1 bg-gold-on-blue mt-3"></div>
        </div>

        <div class="space-y-1 pt-2">
          <p class="text-lg font-semibold text-white">We'd love to hear from you!</p>
          <p class="text-sm sm:text-base text-gray-300">
            Have a question, idea, or ready to plan your event?
          </p>
          <p class="text-sm sm:text-base text-gray-300">
            Our team is here to help make it unforgettable.
          </p>
        </div>
      </div>

      <!-- Hero Right Side Callout -->
      <div class="md:col-span-5 flex items-center border-t md:border-t-0 md:border-l border-gray-700/60 pt-6 md:pt-0 md:pl-10 space-x-6">
        <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-full border-2 border-gold-on-blue flex items-center justify-center shrink-0 bg-[#051329]/60 backdrop-blur-sm shadow-lg">
          <svg class="w-10 h-10 sm:w-12 sm:h-12 text-gold-on-blue" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"></path>
          </svg>
        </div>

        <div class="text-lg sm:text-xl font-bold leading-snug">
          <p class="text-white">Let's create</p>
          <p class="text-brand-gold">something amazing</p>
          <p class="text-white">together.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content: Contact Details & Form -->
  <main class="bg-[#FDFBF7] py-16 px-4 sm:px-6 lg:px-8 font-sans text-gray-900">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <!-- Left Column: Info -->
      <section class="lg:col-span-5 space-y-8 pr-0 lg:pr-6">
        <div>
          <h2 class="text-3xl font-bold text-[#102A43] tracking-tight">
            Get In Touch
          </h2>
          <div class="w-12 h-0.5 bg-gold-on-blue mt-2"></div>
        </div>

        <div class="space-y-6">
          <div class="flex items-start space-x-4">
            <div class="w-12 h-12 rounded-full bg-[#102A43] flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-gold-on-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
              </svg>
            </div>
            <div>
              <h3 class="text-base font-bold text-[#102A43]">Phone</h3>
              <p class="text-sm text-gray-700 mt-0.5">(312) 547-0092</p>
            </div>
          </div>

          <div class="flex items-start space-x-4">
            <div class="w-12 h-12 rounded-full bg-[#102A43] flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-gold-on-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
            </div>
            <div>
              <h3 class="text-base font-bold text-[#102A43]">Email</h3>
              <p class="text-sm text-gray-700 mt-0.5">info@illinoiseventmanagement.com</p>
            </div>
          </div>

          <div class="flex items-start space-x-4">
            <div class="w-12 h-12 rounded-full bg-[#102A43] flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-gold-on-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <div>
              <h3 class="text-base font-bold text-[#102A43]">Address</h3>
              <p class="text-sm text-gray-700 mt-0.5">Serving Clients Across Illinois</p>
            </div>
          </div>

          <div class="flex items-start space-x-4">
            <div class="w-12 h-12 rounded-full bg-[#102A43] flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-gold-on-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <div>
              <h3 class="text-base font-bold text-[#102A43]">Business Hours</h3>
              <p class="text-sm text-gray-700 mt-0.5">
                Mon - Fri: 9:00 AM - 6:00 PM<br />Sat - Sun: By Appointment
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Right Column: Form -->
      <section class="lg:col-span-7 border-t lg:border-t-0 lg:border-l border-gray-200 pt-8 lg:pt-0 lg:pl-12">
        <div class="mb-6">
          <h2 class="text-3xl font-bold text-[#102A43] tracking-tight">
            Send Us a Message
          </h2>
          <div class="w-12 h-0.5 bg-gold-on-blue mt-2 mb-4"></div>
          <p class="text-sm text-gray-700">
            Fill out the form below and we'll get back to you as soon as possible.
          </p>
        </div>

        <!-- Hidden Target Iframe -->
        <iframe name="hidden_iframe" id="hidden_iframe" class="hidden"></iframe>

        <!-- Confirmation Banner (Shown on submit) -->
        <div id="thank-you-message" class="hidden p-6 bg-green-50 border border-green-200 rounded-md text-green-900 mb-6">
          <h3 class="text-lg font-semibold">Thank You!</h3>
          <p class="text-sm mt-1">Your message has been successfully sent. We will get back to you shortly.</p>
        </div>

        <!-- Google Form Form Target -->
        <form
          id="contact-form"
          action="https://docs.google.com/forms/u/1/d/1ydsP5w1MQldRFt4DZe3IF1wO25SJ5-py1WfB0i4rbBI/formResponse"
          method="POST"
          target="hidden_iframe"
          class="space-y-4"
        >
          <!-- Hidden Google Form Fields -->
          <input type="hidden" name="fvv" value="1" />
          <input type="hidden" name="partialResponse" value='[null,null,"3669326334323453494"]' />
          <input type="hidden" name="pageHistory" value="0" />
          <input type="hidden" name="fbzx" value="3669326334323453494" />

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="fullName" class="sr-only">Full Name</label>
              <input
                type="text"
                id="fullName"
                name="entry.570531163"
                placeholder="Full Name*"
                required
                class="w-full px-4 py-3 bg-[#F7F5F0] border border-gray-200 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-gold-on-blue focus:border-transparent placeholder-gray-500"
              />
            </div>
            <div>
              <label for="email" class="sr-only">Email Address</label>
              <input
                type="email"
                id="email"
                name="entry.1849955757"
                placeholder="Email Address*"
                required
                class="w-full px-4 py-3 bg-[#F7F5F0] border border-gray-200 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-gold-on-blue focus:border-transparent placeholder-gray-500"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="phone" class="sr-only">Phone Number</label>
              <input
                type="tel"
                id="phone"
                name="entry.1800095755"
                placeholder="Phone Number*"
                required
                class="w-full px-4 py-3 bg-[#F7F5F0] border border-gray-200 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-gold-on-blue focus:border-transparent placeholder-gray-500"
              />
            </div>
            <div>
              <label for="eventDate" class="sr-only">Event Date</label>
              <input
                type="date"
                id="eventDate"
                name="entry.1347675644"
                required
                class="w-full px-4 py-3 bg-[#F7F5F0] border border-gray-200 rounded-md text-sm text-gray-700 focus:outline-none focus:ring-2 focus:ring-gold-on-blue focus:border-transparent"
              />
            </div>
          </div>

          <div class="relative">
            <label for="eventType" class="sr-only">Event Type</label>
            <select
              id="eventType"
              name="entry.311664358"
              required
              class="w-full px-4 py-3 bg-[#F7F5F0] border border-gray-200 rounded-md text-sm text-gray-700 focus:outline-none focus:ring-2 focus:ring-gold-on-blue focus:border-transparent appearance-none pr-10"
            >
              <option value="" disabled selected>Event Type / Occasion*</option>
              <option value="Corporate Event">Corporate Event</option>
              <option value="Wedding">Wedding</option>
              <option value="Gala / Fundraiser">Gala / Fundraiser</option>
              <option value="Private Party">Private Party</option>
              <option value="Other">Other</option>
            </select>
            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-gray-500">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </div>
          </div>

          <div>
            <label for="message" class="sr-only">Message</label>
            <textarea
              id="message"
              name="entry.1311521313"
              rows="5"
              placeholder="Tell us about your event*"
              required
              class="w-full px-4 py-3 bg-[#F7F5F0] border border-gray-200 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-gold-on-blue focus:border-transparent placeholder-gray-500 resize-none"
            ></textarea>
          </div>

          <!-- Captcha / Security Verification Section -->
          <div class="p-4 bg-[#F7F5F0] border border-gray-200 rounded-md space-y-3">
            <label for="captcha" class="block text-xs font-semibold text-gray-700 uppercase tracking-wider">
              Security Check*
            </label>
            <div class="flex flex-col sm:flex-row sm:items-center gap-3">
              <div class="flex items-center space-x-3 shrink-0">
                <img src="/recapcha.png" alt="Captcha challenge" class="h-10 w-auto object-contain rounded" />
                <span class="text-sm font-semibold text-[#102A43]">Ten + One =</span>
              </div>
              <input
                type="text"
                id="captcha"
                name="entry.1195435683"
                placeholder="Answer*"
                required
                class="w-full sm:w-32 px-3 py-2 bg-white border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-gold-on-blue focus:border-transparent placeholder-gray-400"
              />
            </div>
          </div>

          <button
            type="submit"
            class="inline-flex items-center justify-center px-6 py-3 bg-gold-on-blue hover:opacity-90 text-white text-sm font-semibold rounded-md shadow-sm transition-opacity uppercase tracking-wider space-x-2 cursor-pointer"
          >
            <svg
              class="w-4 h-4 transform rotate-45"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z"
              ></path>
            </svg>
            <span>Send Message</span>
          </button>

          <p class="text-xs text-gray-500 mt-2">* Required Fields</p>
        </form>
      </section>
    </div>
  </main>
  <CallToActionBanner />
</BaseLayout>

<script>
  let submitted = false;
  const iframe = document.getElementById("hidden_iframe");
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const thankYou = document.getElementById("thank-you-message");

  if (form && iframe && thankYou) {
    form.addEventListener("submit", () => {
      submitted = true;
    });

    iframe.addEventListener("load", () => {
      if (submitted) {
        form.reset();
        form.classList.add("hidden");
        thankYou.classList.remove("hidden");
      }
    });
  }
</script>